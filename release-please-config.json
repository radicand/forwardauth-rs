{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "extra-files": [
        {
          "type": "yaml",
          "path": "helm/forwardauth/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "helm/forwardauth/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "yaml",
          "path": "helm/forwardauth/values.yaml",
          "jsonpath": "$.image.tag"
        }
      ]
    }
  }
}
